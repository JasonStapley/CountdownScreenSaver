<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CountdownScreenSaver</RootNamespace>
    <AssemblyName>CountdownScreenSaver</AssemblyName>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Company>Jason Stapley</Company>
    <Product>Countdown Screen Saver</Product>
    <Authors>Jason Stapley</Authors>
    <Description>Countdown Screen Saver. Set a date and a description of the event and watch the screen saver count down.</Description>
    <Copyright>Jason Stapley</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CountdownScreenSaver.Core\CountdownScreenSaver.Core.csproj" />
  </ItemGroup>
</Project>
